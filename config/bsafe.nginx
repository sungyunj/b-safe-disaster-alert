# Nginx Reverse Proxy 설정 파일
# 외부 80 포트 요청을 내부 루프백(127.0.0.1:8080) FastAPI 애플리케이션으로 안전하게 전달.

server {
    listen 80;      # HTTP 표준 80번 포트로 수신
    server_name _;  # 모든 호스트네임 요청 허용

    location / {
        # 1. 포트 포워딩: 외부 요청을 내부 전용 8080 포트로 릴레이
        proxy_pass http://127.0.0.1:8080;

        # 2. 헤더 보존: 클라이언트의 실제 접속 정보(IP, 프로토콜 등)를 FastAPI 백엔드로 전달
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
